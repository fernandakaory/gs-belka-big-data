# Belka Big Data — configuração local do Docker Compose / Airflow
# Copie este arquivo para .env e substitua os valores abaixo.
# NÃO envie o .env com segredos para o GitHub.

# Senha do PostgreSQL utilizado pelo Airflow
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# Segredo usado na autenticação JWT do Airflow
AIRFLOW_JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO

# Chave Fernet válida (base64 URL-safe, 32 bytes) para o Airflow
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=SUBSTITUA_POR_UMA_CHAVE_FERNET_VALIDA

# UID usado pelos contêineres (padrão do docker-compose.yaml)
AIRFLOW_UID=50000
